#!/usr/bin/env bash

shopt -s nullglob globstar
set -e

typeit=0
# Assumes that password is line 1 and username/email is line 2
line=1
while true; do
	case "${1}" in
		"-t"|"--type") typeit=1; shift;;
		"-u"|"--uname") line=2; shift;;
		*) break;;
	esac
done

if [[ -n $WAYLAND_DISPLAY ]]; then
	dmenu="wmenu"
	xdotool="wtype -"
elif [[ -n $DISPLAY ]]; then
	dmenu=dmenu
	xdotool="xdotool type --clearmodifiers --file -"
else
	echo "Error: No Wayland or X11 display detected" >&2
	exit 1
fi

prefix=${PASSWORD_STORE_DIR-~/.password-store}
password_files=( "$prefix"/**/*.gpg )
password_files=( "${password_files[@]#"$prefix"/}" )
password_files=( "${password_files[@]%.gpg}" )

password=$(printf '%s\n' "${password_files[@]}" | "$dmenu" "$@")

[[ -n $password ]] || exit

if [[ $typeit -eq 0 ]]; then
	pass show -c"${line}" "$password" 2>/dev/null
else
	if [[ "${line}" -eq 1 ]]; then
		pass show "$password" | { IFS= read -r pass; printf %s "$pass"; } | $xdotool
	else
		pass show "$password" | { IFS= read -r uname; read -r uname; printf %s "$uname"; } | $xdotool
	fi
fi

