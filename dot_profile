export EDITOR="/usr/bin/kak"

export PATH="$HOME/.local/bin:$PATH"

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_OPT_DIR="$HOME/.local/opt"

# Program configs
export MPD_HOST="$XDG_RUNTIME_DIR/mpd.sock"
export PASSWORD_STORE_DIR="$XDG_DATA_HOME/password-store"
export GNUPGHOME="$XDG_DATA_HOME/gnupg"
export FZF_DEFAULT_OPTS="--reverse --height=50%"
export MANPAGER="less -R --use-color -Dd+r -Du+b"
export NBRC_PATH="$XDG_CONFIG_HOME/nb/nbrc"
. "${XDG_CONFIG_HOME}/nnn/nnnconf"

export CFLAGS="-O2 -march=native"

# Rust
export CARGO_HOME="$XDG_OPT_DIR/rust/cargo"
export RUSTUP_HOME="$XDG_OPT_DIR/rust/rustup"
[ -f "/home/tom/.local/opt/rust/cargo/env" ] && . "/home/tom/.local/opt/rust/cargo/env"

# Run Sway with Intel GPU (card1 on dual-GPU laptop)
[ -c '/dev/dri/card1' ] && export WLR_DRM_DEVICES='/dev/dri/card1'

# Go
export GOPATH="$XDG_DATA_HOME/go"
export GOMODCACHE="$XDG_CACHE_HOME/go/mod"
export PATH="/usr/local/go/bin:$PATH"
export PATH="$GOPATH/bin:$PATH"

# Haskell
export GHCUP_USE_XDG_DIRS="1"
[ -f "$XDG_DATA_HOME/ghcup/env" ] && . "$XDG_DATA_HOME/ghcup/env"

# Ollama
export OLLAMA_NOHISTORY=1

# Plan9
#export PLAN9="/usr/local/plan9"
#export PATH="$PATH:$PLAN9/bin"

# Misc.
export VSCODE_PORTABLE="$XDG_DATA_HOME/vscode"
export RANDFILE="$XDG_CACHE_HOME/rnd"
export NPM_CONFIG_CACHE="$XDG_CACHE_HOME/npm"
export NPM_CONFIG_PREFIX="$XDG_DATA_HOME/npm"
export DOCKER_CONFIG="$XDG_CONFIG_HOME/docker"

export UNITS_HISTORY="$XDG_DATA_HOME/units_history"
export PYTHONSTARTUP="$XDG_CONFIG_HOME/python/pythonrc"
export SQLITE_HISTORY="$XDG_DATA_HOME/sqlite_history"
export GTK2_RC_FILES="$XDG_CONFIG_HOME/gtk-2.0/gtkrc-2.0"
export WGETRC="$XDG_CONFIG_HOME/wget/wgetrc"
export INPUTRC="$XDG_CONFIG_HOME/shell/inputrc"
export ANSIBLE_CONFIG="$XDG_CONFIG_HOME/ansible/ansible.cfg"
export MBSYNCRC="$XDG_CONFIG_HOME/mbsync/config"
export ELECTRUMDIR="$XDG_DATA_HOME/electrum"

# Unused
export XINITRC="$XDG_CONFIG_HOME/x11/xinitrc"
export XAUTHORITY="$XDG_RUNTIME_DIR/Xauthority"
# export XINITRC="$XDG_CONFIG_HOME/x11/xinitrc"

