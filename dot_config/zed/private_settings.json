{
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "ui_font_weight": 350.0,
  "ui_font_size": 13.0,
  "buffer_line_height": {
    "custom": 1.1,
  },
  "buffer_font_weight": 400.0,
  "buffer_font_size": 12.0,
  "buffer_font_family": ".ZedMono",
  "buffer_font_features": {
    "calt": false,
  },
  "use_autoclose": false,
  "languages": {
    "TypeScript": {
      "prettier": { "allowed": false },
    },
    "TSX": {
      "prettier": { "allowed": false },
    },
    "JavaScript": {
      "prettier": { "allowed": false },
    },
  },
  "lsp": {
    "eslint": {
      "settings": {
        "workingDirectory": {
          "mode": "auto",
        },
      },
    },
  },
}
