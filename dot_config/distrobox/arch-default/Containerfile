FROM archlinux:latest

# Remove 'NoExtract' directives that prevent installing manpages, among other things
RUN find /etc/pacman.conf /etc/pacman.d -type f -print0 2>/dev/null \
	| xargs -0 sed -i '/NoExtract.*usr\/share\/man/d;/NoExtract.*usr\/share\/help/d;/NoExtract.*usr\/share\/doc/d;/NoExtract.*etc\/pacman.d\/mirrorlist/d'

RUN pacman-key --init && pacman --noconfirm -Syu && pacman -Fy

RUN pacman -S --noconfirm \
	age \
	aria2 \
	asciidoctor \
	base-devel \
	bash-language-server \
	bc \
	blender \
	chafa \
	chezmoi \
	clang \
	cmake \
	dash \
	fd \
	ffmpegthumbnailer \
	fish \
	fzf \
	gcr \
	git \
	git-filter-repo \
