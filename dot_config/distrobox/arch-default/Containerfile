# `nb`
RUN wget https://raw.github.com/xwmx/nb/master/nb -O /usr/local/bin/nb && \
	chmod +x /usr/local/bin/nb && \
	EDITOR=kak nb completions install --download
RUN npm install -g mozilla-readability-cli @andymatuschak/note-link-janitor

# Lzip suite
WORKDIR /build
RUN wget https://download.savannah.nongnu.org/releases/lzip/lzip-1.26.tar.gz \
	&& tar -xf lzip-*.tar.gz \
	&& cd lzip-1.26 \
	&& ./configure \
	&& make -j"$(nproc)" check \
	&& make install
RUN wget https://download.savannah.nongnu.org/releases/lzip/lzlib/lzlib-1.16.tar.lz \
	&& tar -xf lzlib-*.tar.lz \
	&& cd lzlib-1.16 \
	&& ./configure \
	&& make -j"$(nproc)" check \
	&& make install
RUN wget https://download.savannah.nongnu.org/releases/lzip/plzip/plzip-1.13.tar.lz \
	&& tar -xf plzip-*.tar.lz \
	&& cd plzip-1.13 \
	&& ./configure \
	&& make -j"$(nproc)" check \
	&& make install
RUN wget https://download.savannah.nongnu.org/releases/lzip/tarlz/tarlz-0.29.tar.lz \
	&& tar -xf tarlz-*.tar.lz \
	&& cd tarlz-0.29 \
	&& ./configure \
	&& make -j"$(nproc)" check \
	&& make install
RUN wget https://download.savannah.nongnu.org/releases/lzip/lziprecover/lziprecover-1.26.tar.lz \
	&& tar -xf lziprecover-*.tar.lz \
	&& cd lziprecover-1.26 \
	&& ./configure \
	&& make -j"$(nproc)" check \
	&& make install


RUN useradd -m -G wheel -s /usr/bin/fish tom
WORKDIR /home/tom
RUN rm -rf /build
RUN printf '%%wheel ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/99_tom
USER tom

RUN rustup default stable

RUN git clone https://aur.archlinux.org/yay.git \
	&& cd yay \
	&& makepkg -sir --noconfirm \
	&& cd .. \
	&& rm -rf yay

RUN yay -S --noconfirm \
	tidy-viewer \
	cmake-language-server \
	crystalline-bin \
	clojure-lsp-bin

RUN sudo mandb -c

